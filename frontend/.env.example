# Kagema-FM frontend environment — copy to `.env` and fill in real values.
# Only EXPO_PUBLIC_* vars are embedded in the client bundle; never put secrets here.

# Base URL of the backend API the app talks to.
# In production, prefer setting this per-profile via EAS environment variables
# rather than committing a value.
EXPO_PUBLIC_BACKEND_URL=http://localhost:8001

# Expo dev-server networking (only needed for some tunneled/dev setups).
EXPO_PACKAGER_PROXY_URL=
EXPO_PACKAGER_HOSTNAME=
