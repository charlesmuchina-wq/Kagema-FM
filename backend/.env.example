# Kagema-FM backend environment — copy to `.env` and fill in real values.
# NEVER commit a real .env. This file holds placeholders only.

# --- Required: datastore ---
MONGO_URL=mongodb://localhost:27017
DB_NAME=kagema_fm_db

# --- Auth / signing (set a strong random value in production) ---
# JWT_SECRET=change-me

# --- AI / LLM (optional; features degrade to mock responses when unset) ---
EMERGENT_LLM_KEY=
EMERGENT_LLM_BASE_URL=https://api.emergentmethods.ai/v1
OPENAI_API_KEY=

# --- Maps / traffic / geocoding (optional) ---
GOOGLE_MAPS_API_KEY=
TOMTOM_API_KEY=
MAPBOX_ACCESS_TOKEN=
APPLE_MAPKIT_JWT=
GEOAPIFY_API_KEY=
GEOAPIFY_ROUTING_KEY=
GEOAPIFY_GEOCODING_KEY=
GEOAPIFY_PLACES_KEY=
DISTANCE_MATRIX_API_KEY=

# --- Music metadata (optional) ---
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
LASTFM_API_KEY=

# --- Security / access control (optional) ---
# Comma-separated list of allowed origins; defaults to a safe set when unset.
CORS_ORIGINS=
ADMIN_API_KEY=
CRAWLER_API_KEY=
IP_BLACKLIST=
IP_WHITELIST=

# --- Service URLs (optional; sensible localhost defaults) ---
BACKEND_URL=http://localhost:8001
FRONTEND_URL=http://localhost:3000
