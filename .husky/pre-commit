#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

echo "🔍 Running pre-commit checks..."

# Check for hardcoded values
echo ""
echo "Checking for hardcoded color values..."

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(tsx|ts)$')

if [ -n "$STAGED_FILES" ]; then
    HARDCODED_COLORS=0
    
    for FILE in $STAGED_FILES; do
        # Check for hex colors (e.g., #FF6B35) that aren't in designTokens.ts
        if [ "$FILE" != "frontend/constants/designTokens.ts" ]; then
            COLORS=$(grep -n "#[0-9A-Fa-f]\{6\}" "$FILE" 2>/dev/null || true)
            
            if [ -n "$COLORS" ]; then
                echo "⚠️  Found hardcoded color in $FILE:"
                echo "$COLORS"
                HARDCODED_COLORS=$((HARDCODED_COLORS + 1))
            fi
        fi
    done
    
    if [ $HARDCODED_COLORS -gt 0 ]; then
        echo ""
        echo "❌ Found hardcoded color values in $HARDCODED_COLORS file(s)"
        echo "Please use DESIGN_TOKENS from 'constants/designTokens.ts' instead"
        echo ""
        echo "Example:"
        echo "  ❌ Bad:  color: '#FF6B35'"
        echo "  ✅ Good: color: DESIGN_TOKENS.colors.primary"
        echo ""
        exit 1
    else
        echo "✅ No hardcoded colors found"
    fi
fi

# Check for magic numbers in spacing
echo ""
echo "Checking for magic number spacing values..."

if [ -n "$STAGED_FILES" ]; then
    MAGIC_NUMBERS=0
    
    for FILE in $STAGED_FILES; do
        if [ "$FILE" != "frontend/constants/designTokens.ts" ]; then
            # Look for common spacing patterns like padding: 16, margin: 20, etc.
            SPACING=$(grep -n -E "(padding|margin|gap|width|height).*: [0-9]{2,}" "$FILE" 2>/dev/null | grep -v "DESIGN_TOKENS" || true)
            
            if [ -n "$SPACING" ]; then
                echo "⚠️  Potential magic numbers in $FILE:"
                echo "$SPACING" | head -5
                MAGIC_NUMBERS=$((MAGIC_NUMBERS + 1))
            fi
        fi
    done
    
    if [ $MAGIC_NUMBERS -gt 0 ]; then
        echo ""
        echo "⚠️  Found potential magic numbers in $MAGIC_NUMBERS file(s)"
        echo "Consider using DESIGN_TOKENS.spacing instead"
        echo ""
        echo "Example:"
        echo "  ❌ Bad:  padding: 16"
        echo "  ✅ Good: padding: DESIGN_TOKENS.spacing.md"
        echo ""
        # Don't fail on magic numbers, just warn
    else
        echo "✅ No obvious magic numbers found"
    fi
fi

# Run TypeScript check on staged files
echo ""
echo "Running TypeScript check..."

cd frontend 2>/dev/null || true
if [ -f "package.json" ]; then
    npx tsc --noEmit 2>&1 | head -20
    
    if [ $? -ne 0 ]; then
        echo ""
        echo "❌ TypeScript errors found"
        exit 1
    else
        echo "✅ TypeScript check passed"
    fi
fi

echo ""
echo "✅ All pre-commit checks passed!"
